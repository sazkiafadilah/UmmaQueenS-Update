:root{
  --plum:#5B2C6F;
  --plum-2:#4A235A;
  --cream:#FFF8F0;
  --gold:#FFC857;
  --gold-2:#E8B44A;
  --ink:#1E1B22;
  --muted:#7A6B81;
  --surface:#FFFFFF;
  --surface-2:#FFF8F0;
  --border:#F2E6D8;
  --shadow:0 12px 32px rgba(91,44,111,0.08);
  --radius:20px;
}

@media (prefers-color-scheme: dark){
  :root{
    --cream:#16121A;
    --surface:#1E1A24;
    --surface-2:#221C2B;
    --ink:#FFF8F0;
    --muted:#B8A9C2;
    --border:#2D2440;
    --shadow:0 12px 32px rgba(0,0,0,0.4);
  }
}

*{
  font-family:'Inter',system-ui,-apple-system,sans-serif
}

h1,h2,h3,.font-serif{
  font-family:'Playfair Display',serif
}

.marquee-track{
  animation:marquee 32s linear infinite
}

@keyframes marquee{
  0%{
    transform:translateX(0)
  }

  100%{
    transform:translateX(-50%)
  }
}

.scrollbar-hide::-webkit-scrollbar{
  display:none
}

.scrollbar-hide{
  -ms-overflow-style:none;
  scrollbar-width:none
}

.puisi-ornament:before,.puisi-ornament:after{
  content:"";
  display:inline-block;
  width:36px;
  height:1px;
  background:var(--gold);
  vertical-align:middle;
  margin:0 12px;
  opacity:0.8
}

.line-clamp-2{
  display:-webkit-box;
  -webkit-line-clamp:2;
  -webkit-box-orient:vertical;
  overflow:hidden
}

.selection\:bg-\[var\(--gold\)\] *::-moz-selection{
  background-color: var(--gold);
}

.selection\:bg-\[var\(--gold\)\] *::selection{
  background-color: var(--gold);
}

.selection\:text-black *::-moz-selection{
  --tw-text-opacity: 1;
  color: rgb(0 0 0 / var(--tw-text-opacity, 1));
}

