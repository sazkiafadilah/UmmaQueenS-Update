ltProps,t)l[r]===void 0&&(l[r]=t[r]);return{$$typeof:Qm,type:e,key:i,ref:a,props:l,_owner:Wm.current}}var p=cc,m=cc;var Tr=[{id:"1",title:"Doa di Sepertiga Malam untuk Anak",category:"Puisi",excerpt:"Di hening sepertiga malam, ku bisikkan namamu dalam doa yang tak pernah lelah menunggu jawaban langit.",content:["Jam 03:17. Dapur sudah sepi, cucian piring sudah kering, dan hanya detak jam yang menemani.","Aku bangun bukan karena alarm, tapi karena rindu yang mengetuk. Rindu untuk bicara dengan Allah tentangmu, Nak.","Ya Allah, jika besok aku lalai, ingatkan aku lewat tawanya. Jika aku lelah, kuatkan aku lewat pelukannya.","Kadang aku takut tidak cukup baik. Tapi di sepertiga malam ini, aku belajar: menjadi ibu bukan soal sempurna, tapi soal kembali.","Untuk semua Umma di luar sana yang juga terjaga malam ini — doamu sudah sampai."],date:"21 Mei 2025",read:"4 menit",tags:["#puisi","#doaibu","#sepertigamalam"],featured:!0,mood:"from-[#5B2C6F] via-[#8E4A8A] to-[#FFC857]"},{id:"7",title:"5 Job Freelance Online untuk Umma di Rumah - Mulai 0 Rupiah",category:"Freelance Job",excerpt:"Nggak perlu modal, cuma HP & niat. Ini 5 job yang aku coba sendiri sambil jaga anak tidur siang.",content:["Bismillah, Umma. Aku tulis ini setelah 3 bulan coba freelance sambil jadi ibu rumah tangga. Real, bukan teori.","1. Admin Sosmed Toko Online (Rp 500rb-1,5jt/bulan): Tugasnya balas chat, bikin caption pendek. Cari di Fastwork & Sribulancer, keyword 'admin olshop part-time'.","2. Transkrip Audio Jadi Teks (Rp 25rb/jam audio): Cocok buat Umma yang teliti. Aku pakai tools Otter.ai gratis, lalu edit manual. Klien luar bayar via Payoneer $10/jam.","3. Desain Canva Feed Puisi & Dakwah (Rp 50rb/feed): Modal Canva free. Jual paket 9 feed Rp 150rb. Marketnya ibu-ibu pemilik olshop hijab.","4. Penulis Artikel Parenting Islami (Rp 80-150rb/artikel): Banyak blog butuh penulis ibu yang relate. Portfolio cukup dari blog UmmaQueenS ini.","5. Virtual Assistant Riset Produk Shopee: Tugasnya riset produk laris, bikin list. Dibayar $3-5/jam. Jam kerja fleksibel, cocok pas anak sekolah.","Tips payout: Aku pakai Payoneer untuk klien luar, DANA & GoPay untuk lokal, dan Jago untuk pisah uang jajan anak vs modal usaha. Semua bisa di HP."],date:"20 Mei 2025",read:"7 menit",tags:["#freelance","#jobonline","#umma","#payoneer"],mood:"from-[#1A3C34] via-[#2E6B5E] to-[#FFC857]",isJob:!0,salary:"Rp 500rb - 2jt/bulan",platform:"Fastwork • Sribulancer • Upwork"},{id:"2",title:"Rindu yang Tak Bertepi",category:"Puisi",excerpt:"Ada rindu yang tidak butuh alamat, ia tinggal menetap di dada, seperti doa yang lupa pulang.",content:["Rindu ini tidak berisik. Ia duduk manis di sudut hati, sambil menyeruput teh yang sudah dingin.","Aku rindu pada diriku yang dulu, sebelum kata 'ibu' menambahkan banyak sekali peran.","Tapi rindu juga mengajarkan: aku tidak kehilangan diriku, aku meluaskan diriku.","Jika hari ini kamu juga merindu, tuliskan. Puisi adalah cara rindu berpamitan dengan lebih lembut."],date:"18 Mei 2025",read:"3 menit",tags:["#puisi","#rindu","#catatanumma"],mood:"from-[#2C3E50] via-[#5B2C6F] to-[#FFC857]"},{id:"8",title:"Review Jujur: Sribulancer vs Fastwork vs Upwork untuk Ibu Pemula",category:"Freelance Job",excerpt:"Mana yang paling ramah buat Umma yang baru mulai? Aku coba 3 platform selama 45 hari, ini plus minusnya.",content:["Awalnya aku daftar 3 sekaligus, capek! Tapi biar Umma nggak coba-coba kayak aku, ini rangkuman jujur.","Sribulancer: Paling ramah bahasa Indonesia, banyak job admin & tulis. Saingan masih wajar. Kekurangan: harga cenderung ditekan murah. Payout bisa ke DANA & GoPay langsung, enak!","Fastwork: Tampilan IDN Times banget, clean & cepat. Banyak UMKM cari desain & sosmed. Fitur portofolio bagus. Kekurangan: fee 15%. Tapi cair cepat ke Bank Jago/SeaBank.","Upwork: Pembayaran paling besar ($), tapi butuh profil bahasa Inggris & Connects berbayar. Untuk Umma yang mau klien luar, Payoneer wajib. Aku baru dapat 1 job transkrip $50 di sini.","Kesimpulan UmmaQueen: Mulai di Sribulancer 2 minggu buat portfolio, pindah ke Fastwork untuk harga lebih baik, lalu coba Upwork kalau sudah pede bahasa Inggris.","Link daftar & template proposal yang aku pakai ada di Rekomendasi Umma di bawah — bukan popup, cuma link tulus."],date:"17 Mei 2025",read:"6 menit",tags:["#freelance","#reviewplatform","#sribulancer"],mood:"from-[#0F2A3C] via-[#2C5F7C] to-[#FFC857]",isJob:!0,salary:"Fee 10-20%",platform:"Perbandingan Platform"},{id:"3",title:"3 Cara Menulis Puisi Saat Jadi Ibu Sibuk",category:"Umma Story",excerpt:"Tidak perlu waktu sejam. 7 menit di sela mengaduk sayur pun bisa jadi bait yang jujur dan menyembuhkan.",content:["Dulu aku menunggu mood. Sekarang aku mencuri waktu.","1. Metode Kompor: Tulis 3 baris sambil menunggu air mendidih. Jangan edit. Mentah itu jujur.","2. Metode Notes HP: Satu baris satu napas. Kumpulkan 7 hari, kamu sudah punya 7 bait.","3. Metode Suara Anak: Rekam celoteh anak, transkrip satu kalimatnya, jadikan judul puisi.","Kamu tidak perlu jadi penyair. Cukup jadi ibu yang berani jujur."],date:"16 Mei 2025",read:"5 menit",tags:["#menulis","#umma","#tips"],mood:"from-[#FFF8F0] via-[#FFE8CC] to-[#FFC857]"},{id:"9",title:"Cara Dapat Job Pertama di Upwork Tanpa Pengalaman - Template Proposal",category:"Freelance Job",excerpt:"Nol pengalaman bukan nol kemampuan. Ini cara aku tembus job $20 pertama cuma modal blog puisi ini sebagai portfolio.",content:["Umma, klien luar itu tidak peduli ijazahmu, mereka peduli solusimu. Ini step yang aku lakukan:","Step 1: Profil jangan tulis 'ibu rumah tangga', tulis 'Bilingual Content & Admin Support | Indonesian Mom Blogger with 12k readers'. Jujur tapi jual.","Step 2: Portfolio pakai blog UmmaQueenS ini. Aku screenshot statistik blog, link 3 artikel terbaik, bilang: 'I write relatable content for moms, 4 mins read avg'.","Step 3: Proposal 3 paragraf saja: Paragraf 1 - Aku paham masalahmu, Paragraf 2 - Ini yang akan aku lakukan (bullet), Paragraf 3 - Aku bisa mulai sekarang, budget $X.","Step 4: Apply 5 job per hari yang budget $15-30, filter 'less than 5 proposals'. Jangan apply yang sudah 50+ proposal, tenggelam.","Payout: Setelah $100 pertama, cairkan via Payoneer, lalu tarik ke Bank Digital Jago gratis. Aku pakai Jago biar kepisah dari uang belanja.","Template proposal lengkap + 10 link job low-competition aku taruh di Link Pilihan sidebar ya."],date:"15 Mei 2025",read:"8 menit",tags:["#upwork","#freelancepemula","#templateproposal"],mood:"from-[#2E1A47] via-[#5B2C6F] to-[#4ECDC4]",isJob:!0,salary:"$20 - $100/job",platform:"Upwork • Payoneer"},{id:"4",title:"Review Buku: Menjadi Ibu yang Dicintai Surga",category:"Inspirasi",excerpt:"Bukan buku yang menghakimi, tapi buku yang memeluk. Bab 3-nya membuatku menangis di atas sajadah.",content:["Aku beli buku ini karena cover-nya lembut. Ternyata isinya lebih lembut.","Penulis tidak menyuruh kita menjadi ibu sempurna. Ia hanya mengajak kita hadir.","Hal yang paling kusuka: setiap bab ditutup dengan 'latihan 5 menit'. Bukan teori panjang.","Rekomendasi untuk Umma yang merasa overwhelmed: baca 10 halaman saja sebelum tidur."],date:"14 Mei 2025",read:"6 menit",tags:["#reviewbuku","#parentingislami"],mood:"from-[#EFE6F5] via-[#FFF8F0] to-[#FFDF9E]"},{id:"5",title:"Manajemen Waktu Umma Berbisnis dari Rumah + Job Freelance",category:"Bisnis Umma",excerpt:"Bisnis tidak harus mengorbankan pelukan. Sistem 3 blok ini bikin aku bisa freelance 2 jam/hari tanpa drama.",content:["Aku pernah mencoba kerja 8 jam seperti kantor. Gagal total.","Lalu aku buat sistem Blok Umma: Blok Ibadah & Hati (pagi), Blok Fokus Freelance (saat anak tidur siang), Blok Keluarga (sore tanpa HP).","Rahasianya bukan produktivitas tinggi, tapi ekspektasi yang jujur. Hari ini mungkin hanya bisa balas 3 chat customer.","Tools yang kupakai: Google Calendar warna-warni, timer 25 menit, dan DANA Bisnis untuk pisahkan uang pribadi & usaha."],date:"12 Mei 2025",read:"5 menit",tags:["#bisnisumma","#freelance","#manajemenwaktu"],mood:"from-[#FFF8F0] via-[#FFEDD5] to-[#FFC857]"},{id:"6",title:"Queen di Dapur Kecil",category:"Puisi",excerpt:"Mahkotaku bukan emas, tapi aroma bawang goreng. Tahtaku bukan singgasana, tapi kursi plastik dekat kompor.",content:["Siapa bilang queen harus di istana?","Aku queen di dapur 2x3 meter ini. Dengan spatula sebagai tongkat kerajaan, dan wajan sebagai perisai.","Anak-anak adalah rakyat kecilku yang berisik tapi setia.","Hari ini aku masak sambil bersenandung puisi. Besok mungkin aku menangis karena lelah. Dua-duanya sah."],date:"10 Mei 2025",read:"3 menit",tags:["#puisi","#dapurumma","#queen"],mood:"from-[#FFC857] via-[#FF8A65] to-[#5B2C6F]"}],So=[{id:"a1",title:"Template Proposal Upwork untuk Ibu (Indo-English)",url:"#",desc:"Copy-paste 3 template yang lolos job $20-$50, plus cara setting Payoneer.",badge:"Job Kit",emoji:"\uD83D\uDCBC"},{id:"a2",title:"Buku Harian UmmaQueen - Planner Freelance 2025",url:"#",desc:"Planner dengan tracker job, invoice DANA/GoPay & prompt puisi harian.",badge:"Editor Pick",emoji:"\uD83D\uDCD4"},{id:"a3",title:"Kelas Canva untuk Freelance Sosmed 7 Hari",url:"#",desc:"Bikin portfolio feed 9 kotak dalam 2 jam, langsung jual Rp 150rb.",badge:"Terlaris",emoji:"\uD83C\uDFA8"},{id:"a4",title:"Akun Payoneer + Jago - Tutorial Cair $ Gratis",url:"#",desc:"Step daftar Payoneer, hubungkan ke Bank Digital biar fee minim.",badge:"Payout",emoji:"\uD83D\uDCB3"},{id:"a5",title:"Teh Bunga Telang - Teman Lembur Nulis Proposal",url:"#",desc:"Tanpa gula, menenangkan, biar nggak ngantuk pas bid job malam.",badge:"Rekomendasi",emoji:"\uD83C\uDF75"}],fc=["\uD83D\uDD25 5 Job Freelance 0 Modal untuk Umma","Puisi Rindu Umma viral 12k share","Cara Cair Payoneer ke DANA & Jago","Jurnal Syukur untuk Ibu yang Lelah","Template Proposal Upwork Lolos $50","Doa Sepertiga Malam untuk Anak"],Km=["Semua","Puisi","Freelance Job","Umma Story","Bisnis Umma","Inspirasi"];function No(){let[e,t]=q.useState("Semua"),[n,r]=q.useState(""),[l,i]=q.useState(null),[a,o]=q.useState(So),[u,d]